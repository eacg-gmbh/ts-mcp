{
  "name": "@trustsource/mcp-server",
  "version": "0.3.0",
  "description": "MCP server for the TrustSource REST API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ts-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "codegen": "tsx scripts/codegen.ts",
    "policy:export": "tsx scripts/export-policy.ts",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "docker:build": "docker build -t trustsource/ts-mcp .",
    "prepare": "npm run codegen && npm run build"
  },
  "keywords": [
    "mcp",
    "trustsource",
    "sbom",
    "compliance",
    "security"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "yaml": "^2.7.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "fast-uri": "^3.1.7",
    "hono": "^4.13.5",
    "qs": "^6.16.0",
    "@hono/node-server": "^2.1.1",
    "ip-address": "^10.5.1"
  }
}
